<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="10dp">

    <!-- Top Sanctuary Header: Brand Mark & Live Date Chip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🌿 INVICTUS SANCTUARY"
            android:textColor="@color/widget_text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_date_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sat, 3 Oct • Autumn Bloom"
            android:textColor="@color/widget_text_muted"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Top Terrace Card: Living Biome & Clear Brook (Daily Budget) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/widget_card_inset"
        android:padding="8dp"
        android:layout_marginBottom="6dp">

        <!-- Weather Status & Brook Flow Remaining -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_weather_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="☀️ GOLDEN SUNLIGHT"
                android:textColor="@color/widget_accent_emerald"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_safe_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹650 FLOW LEFT"
                android:textColor="@color/widget_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Cap Subtext / Weather Alert Badge -->
        <TextView
            android:id="@+id/widget_today_badge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="₹350 spent of ₹800 cap"
            android:textColor="@color/widget_text_muted"
            android:textSize="9sp"
            android:singleLine="true" />

        <!-- Brook Water Flow Stream Progress Bar -->
        <ProgressBar
            android:id="@+id/widget_stream_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:max="100"
            android:progress="70"
            android:progressDrawable="@drawable/widget_stream_progress" />

        <!-- River Pebble Liquidity Chips -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_upi_left"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📱 UPI: ₹9,400"
                android:textColor="@color/widget_text_muted"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:singleLine="true" />

            <TextView
                android:id="@+id/widget_cash_left"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="💵 Cash: ₹2,000"
                android:textColor="@color/widget_text_muted"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:singleLine="true" />

            <TextView
                android:id="@+id/widget_days_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="28d left"
                android:textColor="@color/widget_text_muted"
                android:textSize="8.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Split Middle Section: Sacred Flora (Left) & Torii Pathway (Right) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <!-- Left Card: Sacred Flora (Habit Checklist) -->
        <LinearLayout
            android:id="@+id/widget_habits_section"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:orientation="vertical"
            android:background="@drawable/widget_card_inset"
            android:padding="7dp">

            <!-- Flora Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="3dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🌸 SACRED FLORA"
                    android:textColor="@color/widget_text_muted"
                    android:textSize="8sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_habits_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3/4 BLOOMED"
                    android:textColor="@color/widget_accent_emerald"
                    android:textSize="8sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Full Bloom Celebration Banner -->
            <TextView
                android:id="@+id/widget_bloom_celebration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:text="🌸 FULL BLOOM ACHIEVED ✨"
                android:textColor="@color/widget_accent_emerald"
                android:textSize="8sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:visibility="gone" />

            <!-- Habit Row 1 -->
            <LinearLayout
                android:id="@+id/widget_habit_row_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="1dp">

                <TextView
                    android:id="@+id/widget_habit_1_check"
                    android:layout_width="16dp"
                    android:layout_height="wrap_content"
                    android:text="🌸"
                    android:textSize="9.5sp" />

                <TextView
                    android:id="@+id/widget_habit_1_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Morning Workout"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/widget_habit_1_streak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔥 5d"
                    android:textColor="@color/widget_accent_amber"
                    android:textSize="7.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Habit Row 2 -->
            <LinearLayout
                android:id="@+id/widget_habit_row_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/widget_habit_2_check"
                    android:layout_width="16dp"
                    android:layout_height="wrap_content"
                    android:text="🌸"
                    android:textSize="9.5sp" />

                <TextView
                    android:id="@+id/widget_habit_2_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Hydration 3L"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/widget_habit_2_streak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔥 12d"
                    android:textColor="@color/widget_accent_amber"
                    android:textSize="7.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Habit Row 3 -->
            <LinearLayout
                android:id="@+id/widget_habit_row_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/widget_habit_3_check"
                    android:layout_width="16dp"
                    android:layout_height="wrap_content"
                    android:text="🌱"
                    android:textSize="9.5sp" />

                <TextView
                    android:id="@+id/widget_habit_3_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="DSA Sprint 2h"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/widget_habit_3_streak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔥 3d"
                    android:textColor="@color/widget_accent_amber"
                    android:textSize="7.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Habit Empty Fallback -->
            <TextView
                android:id="@+id/widget_habits_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="🌱 Tap to tend flora"
                android:textColor="@color/widget_text_muted"
                android:textSize="9sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Right Card: Sacred Torii Pathway (Active Goal) -->
        <LinearLayout
            android:id="@+id/widget_goal_section"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:orientation="vertical"
            android:background="@drawable/widget_card_inset"
            android:padding="7dp">

            <!-- Torii Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="3dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⛩️ TORII PATHWAY"
                    android:textColor="@color/widget_text_muted"
                    android:textSize="8sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_goal_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎯"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- Goal Title -->
            <TextView
                android:id="@+id/widget_goal_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Master System Design"
                android:textColor="@color/widget_text_primary"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:singleLine="true" />

            <!-- Torii Gate Checkpoint Status -->
            <TextView
                android:id="@+id/widget_goal_gate_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="⛩️ Gate 3 of 5 Passed"
                android:textColor="@color/widget_accent_emerald"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:singleLine="true" />

            <!-- Torii Pathway Stepped Progress Bar -->
            <ProgressBar
                android:id="@+id/widget_goal_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="3dp"
                android:max="100"
                android:progress="65"
                android:progressDrawable="@drawable/widget_torii_progress" />

            <!-- Milestone Completion Subtext -->
            <TextView
                android:id="@+id/widget_goal_percentage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="65% • Summit Ascent"
                android:textColor="@color/widget_text_muted"
                android:textSize="8sp"
                android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Bar: Minimal Zen Action Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_btn_add_expense"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:background="@drawable/widget_button_log"
            android:gravity="center"
            android:text="💧 Log"
            android:textColor="@color/widget_border"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_check_habits"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/widget_button_habit"
            android:gravity="center"
            android:text="🌸 Habits"
            android:textColor="@color/widget_text_primary"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_active_goal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:background="@drawable/widget_button_goal"
            android:gravity="center"
            android:text="⛩️ Path"
            android:textColor="@color/widget_border"
            android:textSize="10.5sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
