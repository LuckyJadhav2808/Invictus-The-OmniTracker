<?xml version="1.0" encoding="utf-8"?>
<!--
    Invictus Daily Overview — Refined Neobrutalist Split Deck
    Authentic Invictus Design System: Warm cream, solid #161514 borders, #CEF431 accents.
    High-contrast financial pacing on the left, live habit checklist on the right.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Top Bar: Branded Invictus Header & Date / Days Left Pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="7dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚡ INVICTUS DAILY"
            android:textColor="@color/widget_text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_date_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TODAY • 24d left"
            android:textColor="@color/widget_text_muted"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Main Content: Dual Split Deck Cards (Finances Left • Habits Right) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="8dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- Left Card: Financial Pace & Liquidity Cockpit -->
        <LinearLayout
            android:id="@+id/widget_finance_section"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_card_inset"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- Card Header: Spent Today & Allowance Status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_hero_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="SPENT TODAY"
                    android:textColor="@color/widget_text_muted"
                    android:textSize="8.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_days_left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="24d left"
                    android:textColor="@color/widget_text_muted"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Big Bold Hero Stat: Spent Today -->
            <TextView
                android:id="@+id/widget_safe_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="₹0"
                android:textColor="@color/widget_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Remaining Allowance Pill Sub-badge -->
            <TextView
                android:id="@+id/widget_today_badge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:singleLine="true"
                android:text="₹168 left (₹500 cap)"
                android:textColor="@color/widget_accent_emerald"
                android:textSize="8.5sp"
                android:textStyle="bold" />

            <!-- Hairline Divider -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:background="@color/widget_border_subtle" />

            <!-- Liquidity Breakdown: UPI & Cash Balances -->
            <TextView
                android:id="@+id/widget_upi_left"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="📱 UPI: ₹12,400"
                android:textColor="@color/widget_text_primary"
                android:textSize="8.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_cash_left"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1.5dp"
                android:singleLine="true"
                android:text="💵 Cash: ₹3,200"
                android:textColor="@color/widget_text_muted"
                android:textSize="8.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Right Card: Today's Habits Checklist -->
        <LinearLayout
            android:id="@+id/widget_habits_section"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_card_inset"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- Card Header: Title & Progress Count -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="TODAY'S HABITS"
                    android:textColor="@color/widget_text_muted"
                    android:textSize="8.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_habits_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0/0 DONE"
                    android:textColor="@color/widget_accent_emerald"
                    android:textSize="8.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Habit Item Row 1 -->
            <LinearLayout
                android:id="@+id/widget_habit_row_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_habit_1_check"
                    android:layout_width="14dp"
                    android:layout_height="wrap_content"
                    android:text="○"
                    android:textColor="@color/widget_text_muted"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_habit_1_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:singleLine="true"
                    android:text="Habit 1"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_habit_1_streak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔥 3d"
                    android:textColor="@color/widget_accent_amber"
                    android:textSize="8sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Habit Item Row 2 -->
            <LinearLayout
                android:id="@+id/widget_habit_row_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_habit_2_check"
                    android:layout_width="14dp"
                    android:layout_height="wrap_content"
                    android:text="○"
                    android:textColor="@color/widget_text_muted"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_habit_2_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:singleLine="true"
                    android:text="Habit 2"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_habit_2_streak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔥 5d"
                    android:textColor="@color/widget_accent_amber"
                    android:textSize="8sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Habit Item Row 3 -->
            <LinearLayout
                android:id="@+id/widget_habit_row_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_habit_3_check"
                    android:layout_width="14dp"
                    android:layout_height="wrap_content"
                    android:text="○"
                    android:textColor="@color/widget_text_muted"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_habit_3_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:singleLine="true"
                    android:text="Habit 3"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_habit_3_streak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔥 1d"
                    android:textColor="@color/widget_accent_amber"
                    android:textSize="8sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Habit Empty Fallback -->
            <TextView
                android:id="@+id/widget_habits_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:singleLine="true"
                android:text="🌱 Tap to check habits"
                android:textColor="@color/widget_text_muted"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Bar: Dual Neobrutalist Action Buttons (+ EXPENSE & ✓ HABITS) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_btn_add_expense"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_background"
            android:gravity="center"
            android:text="+ EXPENSE"
            android:textColor="#161514"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_check_habits"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_secondary"
            android:gravity="center"
            android:text="✓ HABITS"
            android:textColor="#161514"
            android:textSize="10.5sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
