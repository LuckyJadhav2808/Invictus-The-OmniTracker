<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_speedway_background"
    android:padding="10dp">

    <!-- Top Speedway Header: Racing Brand & Telemetry Chip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/widget_speedway_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🏎️ INVICTUS SPEEDWAY"
            android:textColor="@color/widget_speedway_border"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_speedway_date_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sat, 3 Oct • Turbo Cruise"
            android:textColor="@color/widget_speedway_text_muted"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Top Cockpit Card: Fuel Gauge & Speedometer Telemetry -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/widget_speedway_card_inset"
        android:padding="8dp"
        android:layout_marginBottom="6dp">

        <!-- Fuel Label & Cruising Pace -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_speedway_fuel_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⛽ FUEL: 74% • ₹1,420 RANGE"
                android:textColor="@color/widget_speedway_border"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_speedway_pace_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CRUISING 98 KM/H"
                android:textColor="@color/widget_speedway_cyan"
                android:textSize="9.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Fuel Gauge Progress Bar -->
        <ProgressBar
            android:id="@+id/widget_speedway_fuel_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="4dp"
            android:max="100"
            android:progress="74"
            android:progressDrawable="@drawable/widget_speedway_fuel_progress" />

        <!-- Subtext Telemetry (Budget Burn & RPM) -->
        <TextView
            android:id="@+id/widget_speedway_telemetry_subtext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="₹350 spent of ₹1,400 daily fuel cap • 4,200 RPM"
            android:textColor="@color/widget_speedway_text_muted"
            android:textSize="8.5sp"
            android:layout_marginBottom="4dp" />

        <!-- Liquid Reserves Telemetry Chips -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_speedway_upi_left"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📱 Tank: ₹9,400"
                android:textColor="@color/widget_speedway_text"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_speedway_cash_left"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="💵 Nitro: ₹2,000"
                android:textColor="@color/widget_speedway_text"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_speedway_days_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="28d to Checkpoint"
                android:textColor="@color/widget_speedway_yellow"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Center Section: Split Highway Milestone & Pit Crew Diagnostics -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:layout_marginBottom="6dp">

        <!-- Highway Milestone Overhead Sign Card (Left - 50%) -->
        <LinearLayout
            android:id="@+id/widget_speedway_milestone_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/widget_speedway_card_inset"
            android:padding="8dp"
            android:layout_marginEnd="3dp">

            <!-- Card Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🛣️ ROAD MILESTONE"
                    android:textColor="@color/widget_speedway_cyan"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_speedway_goal_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎯"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Goal Title -->
            <TextView
                android:id="@+id/widget_speedway_goal_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tokyo Trip 2026"
                android:textColor="@color/widget_speedway_text"
                android:textSize="11sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Milestone Status -->
            <TextView
                android:id="@+id/widget_speedway_goal_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Exit 12 • 68% Reached"
                android:textColor="@color/widget_speedway_text_muted"
                android:textSize="8.5sp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="4dp" />

            <!-- Milestone Progress Bar -->
            <ProgressBar
                android:id="@+id/widget_speedway_goal_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:max="100"
                android:progress="68"
                android:progressDrawable="@drawable/widget_speedway_milestone_progress"
                android:layout_marginBottom="4dp" />

            <!-- Road Horizon Telemetry -->
            <TextView
                android:id="@+id/widget_speedway_goal_telemetry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Speedway Lane 1 • Full Throttle"
                android:textColor="@color/widget_speedway_border"
                android:textSize="8sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Pit Crew Diagnostics Card (Right - 50%) -->
        <LinearLayout
            android:id="@+id/widget_speedway_habits_section"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/widget_speedway_card_inset"
            android:padding="8dp"
            android:layout_marginStart="3dp">

            <!-- Card Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="3dp">

                <TextView
                    android:id="@+id/widget_speedway_habits_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🏎️ PIT CREW"
                    android:textColor="@color/widget_speedway_yellow"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_speedway_habits_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3/3 READY"
                    android:textColor="@color/widget_speedway_text"
                    android:textSize="8.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- All Clear Celebration Banner -->
            <TextView
                android:id="@+id/widget_speedway_all_clear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🏁 ALL SYSTEMS OPTIMAL ✨"
                android:textColor="@color/widget_speedway_border"
                android:textSize="8sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="2dp"
                android:visibility="gone" />

            <!-- Empty State -->
            <TextView
                android:id="@+id/widget_speedway_habits_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No pit stops queued. Tap [🏎️ PIT CREW] to configure."
                android:textColor="@color/widget_speedway_text_muted"
                android:textSize="8sp"
                android:visibility="gone" />

            <!-- Diagnostic Habit Row 1 -->
            <LinearLayout
                android:id="@+id/widget_speedway_habit_row_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="2dp">

                <TextView
                    android:id="@+id/widget_speedway_habit_1_led"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🟢"
                    android:textSize="9sp"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/widget_speedway_habit_1_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Code Run"
                    android:textColor="@color/widget_speedway_text"
                    android:textSize="8.5sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_speedway_habit_1_streak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔥 5d"
                    android:textColor="@color/widget_speedway_yellow"
                    android:textSize="8sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Diagnostic Habit Row 2 -->
            <LinearLayout
                android:id="@+id/widget_speedway_habit_row_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="2dp">

                <TextView
                    android:id="@+id/widget_speedway_habit_2_led"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🟢"
                    android:textSize="9sp"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/widget_speedway_habit_2_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Hydrate"
                    android:textColor="@color/widget_speedway_text"
                    android:textSize="8.5sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_speedway_habit_2_streak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔥 12d"
                    android:textColor="@color/widget_speedway_yellow"
                    android:textSize="8sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Diagnostic Habit Row 3 -->
            <LinearLayout
                android:id="@+id/widget_speedway_habit_row_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/widget_speedway_habit_3_led"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🟠"
                    android:textSize="9sp"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/widget_speedway_habit_3_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Morning Lift"
                    android:textColor="@color/widget_speedway_text"
                    android:textSize="8.5sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_speedway_habit_3_streak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔥 3d"
                    android:textColor="@color/widget_speedway_yellow"
                    android:textSize="8sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Speedway Action Bar: 3 Arcade Tactile Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- [⛽ REFUEL $] -->
        <TextView
            android:id="@+id/widget_speedway_btn_refuel"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:background="@drawable/widget_speedway_btn_refuel"
            android:gravity="center"
            android:text="[⛽ REFUEL $]"
            android:textColor="#161514"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <!-- [🏎️ PIT CREW] -->
        <TextView
            android:id="@+id/widget_speedway_btn_pitcrew"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/widget_speedway_btn_pitcrew"
            android:gravity="center"
            android:text="[🏎️ PIT CREW]"
            android:textColor="@color/widget_speedway_border"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <!-- [🗺️ ROUTE MAP] -->
        <TextView
            android:id="@+id/widget_speedway_btn_routemap"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:background="@drawable/widget_speedway_btn_routemap"
            android:gravity="center"
            android:text="[🗺️ ROUTE MAP]"
            android:textColor="@color/widget_speedway_cyan"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
