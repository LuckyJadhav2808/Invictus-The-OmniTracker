<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <solid android:color="@color/widget_speedway_card_inner" />
            <corners android:radius="4dp" />
            <stroke android:width="1dp" android:color="@color/widget_speedway_border_dark" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <solid android:color="@color/widget_speedway_border" />
                <corners android:radius="4dp" />
            </shape>
        </clip>
    </item>
</layer-list>
